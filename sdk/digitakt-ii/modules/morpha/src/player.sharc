; SPDX-License-Identifier: GPL-3.0-or-later
; Morpha's wavetable player for the Digitakt II sound chip (OS 1.17), assembled by src/engine/elektron/sharc-asm.ts.
;
; The base's machine dispatcher jumps here for every voice of a Morpha track, once per 32-sample block, with the
; registers of the stock sample player's call: R4 = the voice's record (byte address), R8 = its output slot, R12 = 32,
; R14 = 32 - voice, and the caller's frame. The player writes the voice's 32 samples into the slot and returns as the
; stock player does (CRET). Facts about the records: sdk/machines/digitakt-ii/elekloader/modwerk/MACHINES.md.
;
; The wavetable is the track's sample or, with no sample, the built-in table below: 48 waves of 256 samples, from sine
; through triangle, saw, square and pulse to two vowel-like waves with the spectra in between, made by
; tools/builtin-table.mjs from formulas. A sample whose length is a whole number of 2,048-sample waves is a wavetable
; file: POS picks the place in it and the player morphs linearly between the two waves around it, as for the built-in
; table. Any other sample is scanned: the wave is the 2,048 samples from a start POS moves smoothly through the whole
; sample, sample by sample, its last 256 samples crossfaded into the ones before its start so the cycle joins without
; a click (a sample shorter than 2,048 is one wave). The pitch is the record's step (TUNE, the note, pitch locks and
; LFOs, as SAMPLE plays a sample), so a step of one sample per sample plays middle C.
;
; Each voice runs up to three oscillators (DETN: the two outer ones detuned up and down) and a sine one octave down
; that MIX blends in (full: the wave alone; 0: the sub alone). WARP (SAMPLE's play mode) bends each oscillator's phase before the wave is read: BEND pushes it towards the
; wave's ends, SYNC restarts the wave up to four times a cycle, MIRR plays it forward then back; FOLD folds the wave's
; level instead. AMT sets how much.
;
; The two voices of a track (voice v plays track v / 2, the pair rendered one after the other in the same block)
; play the same note: the second copies the first's block, so they never drift apart (Granula found a pair whose
; grains differed partly cancelled) and a note costs one voice's work.
;
; Memory (Morpha's L2 range 0x200f0000-0x200fa000, loader byte addresses; claim dsp-region digitakt-ii/morpha-l2):
;   code 0x200f0000, variables 0x200f3000, voice state 0x200f3100 (32 x 8 words), built-in table 0x200f4000
;   (6,144 words, to 0x200fa000, the range's end).
; I registers hold byte addresses and M registers count words; DM(constant) takes a normal word address (byte / 4).
; Sample memory: I = the record's word 0, M = a word; each word holds two 16-bit samples, the earlier one in its low
; half (emulator dump of a 220 Hz test sample: 109.5 words a cycle, the low half the earlier sample).

.equ RECB, 0x1d8                ; bytes per voice record
.equ R_ADDR, 0                  ; record word: the sample's address, 0 for no sample
.equ R_RATE, 0x61               ; record word: the sample's rate (48,000)
.equ R_SAMPLES, 0x62            ; record word: the sample's length in samples
.equ R_STEPF, 0x6a              ; record word: the step's fraction
.equ R_STEPW, 0x6b              ; record word: the step's whole part, negative when the play mode reverses
.equ R_PLAYING, 0x6e            ; record word: nonzero while a note plays
.equ R_LOOPING, 0x6f            ; record word: 1 in the loop play modes
.equ KNOBS, 0x200c2d34          ; the base's wire: each track's knobs C and E (DT2_BASE_SHARC.trackKnobs, byte address)
.equ PREC0, 0x250738            ; voice 0's parameter record (byte address); 0xdc bytes per voice
.equ PRECB, 0xdc
.equ P_MIX, 0x26                ; knob F (SAMPLE's LENGTH) as 0-1, full on a new track
.equ P_DETN, 0x27               ; knob G (SAMPLE's LOOP position) as 0-1, 0 on a new track

.equ VARS, 0x200f3000
.equ V, VARS / 4
.equ V_SLOT, V + 0              ; the voice's output slot
.equ V_REC, V + 1               ; its record
.equ V_MODE, V + 2              ; WARP: 0 BEND, 1 SYNC, 2 MIRR, 3 FOLD
.equ V_INC, V + 3               ; the centre oscillator's phase step (cycles a sample)
.equ V_INC1, V + 4              ; the upper detuned one's
.equ V_INC2, V + 5              ; the lower detuned one's
.equ V_SRC, V + 6               ; the table's address (the sample's, or the built-in table's)
.equ V_FRAMES, V + 7            ; waves in the table
.equ V_FLEN, V + 8              ; samples a wave
.equ V_FLENF, V + 9             ; the same, as a float
.equ V_OFF0, V + 10             ; the first wave's index in the table
.equ V_OFF1, V + 11             ; the next wave's
.equ V_T, V + 12                ; how far from the first wave to the next, 0-1
.equ V_AMT, V + 13
.equ V_DETN, V + 14
.equ V_MIX, V + 15
.equ V_POS, V + 16
.equ V_G, V + 17                ; the outer oscillators' level
.equ V_UNI, V + 18              ; nonzero: three oscillators
.equ V_WGAIN, V + 19            ; the waves' output gain (with 1 / 32768)
.equ V_SGAIN, V + 20            ; the sub's
.equ V_1MA, V + 21              ; 1 - AMT (BEND)
.equ V_SYNC, V + 22             ; 1 + 3 AMT (SYNC)
.equ V_FOLDK, V + 23            ; (1 + 4 AMT) / 32768 (FOLD)
.equ V_TRACK, V + 24            ; the voice's track
.equ V_VWHICH, V + 25           ; the view's wave being sent: -1 the one that sounds, else a wave of the table
.equ V_VFILL, V + 26            ; words of it written, 0-24
.equ V_VNEXT, V + 27            ; the next of twelve table waves to send, 0-11
.equ V_VP, V + 28               ; the next point, 0-95
.equ V_VJ, V + 29               ; the point within the word, 0-3
.equ V_VSERIAL, V + 30          ; counts the view's posts
.equ V_SUBINC, V + 31           ; the sub's phase step (an octave down, not below C1)
.equ V_VCOUNT, V + 56           ; counts the view's waves: three sounding waves to one table wave
.equ V_TMP, V + 57              ; osc's scratch word
.equ V_SCAN, V + 58             ; nonzero: the sample is scanned (not a whole number of 2,048-sample waves)
.equ V_LEN, V + 59              ; the sample's length in samples
.equ V_SAVE, V + 32             ; 24 saved registers

; The view (the base's machine view, mk2/machines.h): 32 words about the view track's voice, which the base sends back
; to the ColdFire with every transfer. Word 0 the magic, 1 the track, 2 POS (0-65535), 3 WARP | AMT (0-255) << 8 |
; the table's waves << 16, 4 which wave words 8-31 show (-1 the one that sounds, warped and morphed; else that wave of
; the table, plain), 5 how many of words 8-31 are written for it (24 when whole), 6 a serial, 7 which of the twelve
; table waves sent (0-11, the last one sent), 8-31 the wave: 96 points, four signed bytes a word, the first in the low
; byte, each the wave's level / 256. A block writes one word, so a wave takes 24 blocks (16 ms) and then stays 64
; more; the player sends the sounding wave three times, then a table wave, twelve table waves n (waves - 1) / 11.
.equ VIEW_TRACK, 0x200c2c64 / 4
.equ VIEW, 0x200c2c68 / 4
.equ VIEWB, 0x200c2c68
.equ VIEW_MAGIC, 0x4d525031     ; "MRP1"

.equ VSTATE, 0x200f3100         ; per voice 8 words: the three oscillators' phases, the sub's (floats, 0-1)
.equ VSTATEB, 32
.equ BUILTIN, 0x200f4000        ; the built-in table: 48 waves x 256 samples, packed as sample memory is

.code 0x200f0000
morpha_player:
  DM(V_SAVE + 0) = R3
  DM(V_SAVE + 1) = R5
  DM(V_SAVE + 2) = R6
  DM(V_SAVE + 3) = R7
  DM(V_SAVE + 4) = R9
  DM(V_SAVE + 5) = R10
  DM(V_SAVE + 6) = R11
  DM(V_SAVE + 7) = R15
  DM(V_SAVE + 8) = I0
  DM(V_SAVE + 9) = I1
  DM(V_SAVE + 10) = I2
  DM(V_SAVE + 11) = I3
  DM(V_SAVE + 12) = M0
  DM(V_SAVE + 13) = M1
  DM(V_SAVE + 14) = M2
  DM(V_SAVE + 15) = M3
  DM(V_SAVE + 16) = L0
  DM(V_SAVE + 17) = L1
  DM(V_SAVE + 18) = L2
  DM(V_SAVE + 19) = ASTATX
  DM(V_SAVE + 20) = STKYX
  DM(V_SAVE + 21) = R13
  DM(V_SAVE + 22) = R14
  L0 = 0
  L1 = 0
  L2 = 0
  L3 = 0
  L4 = 0
  M0 = 1
  M3 = 0
  DM(V_SLOT) = R8
  R0 = 32
  R9 = R0 - R14                 ; R9: the voice, 0-31
  R1 = -1
  R0 = LSHIFT R9 BY R1
  DM(V_TRACK) = R0
  R0 = 1
  R0 = R9 AND R0
  IF NE JUMP copy_pair          ; the second voice of the track plays what the first just played

  R1 = VSTATEB
  R0 = R9 * R1 (SSI)
  R1 = VSTATE
  R0 = R0 + R1
  I2 = R0                       ; I2: this voice's state
  I1 = R4                       ; I1: its record
  DM(V_REC) = R4

; The knobs, each held in 0-1 and glided (state words 4-7) so a knob's steps become smooth sweeps. C and E at full
; resolution from the base's wire (a word a track: C | E << 16, each value << 8; the parameter record gets C as 0 or
; 1 only), F and G from the voice's parameter record.
  R0 = DM(V_TRACK)
  R1 = 4
  R0 = R0 * R1 (SSI)
  R1 = KNOBS
  R0 = R0 + R1
  I0 = R0                       ; I0: the track's knob word (I0 is the output slot only from the block on)
  R5 = 0xffff
  R6 = -16
  R7 = DM(M3, I0)               ; C | E << 16 (in R7: glide changes F2, which is R2)
  R3 = R7 AND R5
  F0 = FLOAT R3
  F1 = 0.0000307578             ; 1 / 0x7f00 (C: 0-127)
  F0 = F0 * F1
  CALL unit
  R1 = 5
  CALL glide
  DM(V_AMT) = F0
  R3 = LSHIFT R7 BY R6
  F0 = FLOAT R3
  F1 = 0.0000325521             ; 1 / 0x7800 (E: START, 0-120)
  F0 = F0 * F1
  CALL unit
  R1 = 4
  CALL glide
  DM(V_POS) = F0
  R1 = PRECB
  R0 = R9 * R1 (SSI)
  R1 = PREC0
  R0 = R0 + R1
  I3 = R0                       ; I3: the voice's parameter record
  R1 = P_MIX
  M1 = R1
  F0 = DM(M1, I3)
  CALL unit
  R1 = 6
  CALL glide
  DM(V_MIX) = F0
  R1 = P_DETN
  M1 = R1
  F0 = DM(M1, I3)
  CALL unit
  R1 = 7
  CALL glide
  DM(V_DETN) = F0

; WARP from the play mode: the step's sign (REV) and the loop flag.
  R1 = R_STEPW
  M1 = R1
  R2 = DM(M1, I1)               ; the step's whole part
  R1 = R_STEPF
  M1 = R1
  R3 = DM(M1, I1)               ; and its fraction
  R1 = R_LOOPING
  M1 = R1
  R7 = DM(M1, I1)
  R0 = 1
  R7 = MIN(R7, R0)
  R0 = 0
  R7 = MAX(R7, R0)              ; R7: 1 in a loop mode
  R6 = 0
  R0 = PASS R2
  IF LT CALL negate             ; R6 = 1 and the step's size, forward
  R1 = 3
  R1 = R1 - R7
  R0 = PASS R6
  IF NE R7 = PASS R1            ; FWD 0 BEND, FWD.L 1 SYNC, REV.L 2 MIRR, REV 3 FOLD
  DM(V_MODE) = R7

; The pitch: the step in cycles a sample.
  F0 = FLOAT R2
  R1 = -8
  R3 = LSHIFT R3 BY R1          ; the fraction's top 24 bits
  F1 = FLOAT R3
  F4 = 0.000000059604645        ; 2^-24
  F1 = F1 * F4
  F0 = F0 + F1
; The stock setup multiplies the step by the sample's rate / 48,000 (record word 0x61, at 0x1c4c2e); a wavetable's
; waves have a length, not a rate, and with no sample the word is left over (emulator: 5 cents sharp). Divide it out.
  R1 = R_RATE
  M1 = R1
  R2 = DM(M1, I1)
  R3 = 8000
  COMP(R2, R3)
  IF LT JUMP rate_done
  R3 = 192000
  COMP(R2, R3)
  IF GT JUMP rate_done
  F2 = FLOAT R2
  F3 = RECIPS F2                ; refined twice: x (2 - a x)
  F4 = F2 * F3
  F5 = 2.0
  F4 = F5 - F4
  F3 = F3 * F4
  F4 = F2 * F3
  F4 = F5 - F4
  F3 = F3 * F4
  F4 = 48000.0
  F3 = F3 * F4
  F0 = F0 * F3
rate_done:
  F1 = 0.0218021333             ; cycles a sample at a step of one: 4 x 261.6256 / 48000 (the step counts quarter
  F9 = F0 * F1                  ; samples; a float must be written here, an .equ name loads its value as an integer)
  DM(V_INC) = F9
; The sub: an octave down, but never below C1 (32.7 Hz): lower notes take it up an octave at a time instead.
  F1 = 0.5
  F1 = F9 * F1
  F2 = 0.000681317              ; 32.7032 / 48000
  R0 = 8
sub_floor:
  COMP(F1, F2)
  IF GE JUMP sub_set
  F1 = F1 + F1
  R0 = R0 - 1
  IF NE JUMP sub_floor
sub_set:
  DM(V_SUBINC) = F1

; The table: the sample, or the built-in one.
  R5 = 0
  DM(V_SCAN) = R5
  R0 = DM(M3, I1)
  R1 = R_SAMPLES
  M1 = R1
  R2 = DM(M1, I1)
  DM(V_LEN) = R2
  R0 = PASS R0
  IF EQ JUMP use_builtin
  R1 = 4
  COMP(R2, R1)
  IF LT JUMP use_builtin
  DM(V_SRC) = R0
  R1 = -11
  R3 = LSHIFT R2 BY R1          ; R3: whole waves of 2,048
  R4 = 2048
  R3 = PASS R3
  IF EQ JUMP table_short
  R5 = 2047
  R5 = R2 AND R5                ; a wavetable file is a whole number of waves
  IF EQ JUMP table_set
  R5 = 1
  DM(V_SCAN) = R5               ; any other sample is scanned
  JUMP table_set
table_short:
  R3 = 1                        ; a shorter sample is one wave
  R4 = PASS R2
  JUMP table_set
use_builtin:
  R0 = BUILTIN
  DM(V_SRC) = R0
  R3 = 48
  R4 = 256
table_set:
  DM(V_FRAMES) = R3
  DM(V_FLEN) = R4
  F0 = FLOAT R4
  DM(V_FLENF) = F0

; POS: the two waves around it and how far between them; for a scanned sample, the wave's first sample.
  R0 = DM(V_SCAN)
  R0 = PASS R0
  IF NE JUMP pos_scan
  R1 = R3 - 1                   ; R1: the last wave
  F0 = DM(V_POS)
  F2 = FLOAT R1
  F0 = F0 * F2
  R0 = FIX F0
  F2 = FLOAT R0
  COMP(F2, F0)
  IF GT R0 = R0 - 1
  F2 = FLOAT R0
  F5 = F0 - F2                  ; F5: between, 0-1
  R2 = 0
  R0 = MAX(R0, R2)
  R0 = MIN(R0, R1)
  COMP(R0, R1)
  IF GE F5 = F5 - F5            ; on the last wave there is no next
  DM(V_T) = F5
  R2 = R0 * R4 (SSI)
  DM(V_OFF0) = R2
  R2 = R2 + R4
  DM(V_OFF1) = R2
  JUMP pos_done
pos_scan:
  R1 = DM(V_LEN)
  R1 = R1 - R4                  ; R1: the last start (the length - 2,048)
  F2 = FLOAT R1
  F0 = DM(V_POS)
  F0 = F0 * F2
  R0 = FIX F0
  R2 = 0
  R0 = MAX(R0, R2)
  R0 = MIN(R0, R1)
  DM(V_OFF0) = R0
  DM(V_OFF1) = R0
  F5 = 0.0
  DM(V_T) = F5                  ; no second wave
pos_done:

; DETN: the outer oscillators' pitch (up to +-3%, about half a semitone) and level; three only when turned up.
  F0 = DM(V_DETN)
  F1 = 0.03
  F1 = F0 * F1
  F2 = 1.0
  F3 = F2 + F1
  F3 = F9 * F3
  DM(V_INC1) = F3
  F4 = F2 - F1
  F4 = F9 * F4
  DM(V_INC2) = F4
  F1 = 4.0
  F1 = F0 * F1
  F1 = MIN(F1, F2)
  DM(V_G) = F1                  ; F1: the outer level
  R4 = 0                        ; (not R0: R0 is F0, DETN)
  F3 = 0.001
  COMP(F0, F3)
  IF GT R4 = R4 + 1
  DM(V_UNI) = R4
  R4 = PASS R4
  IF EQ F1 = F1 - F1            ; one oscillator: no outer level in the gain

; The gains: detuned oscillators add up as noise does, 1 / sqrt(1 + 2 g^2).
  F3 = F1 * F1
  F3 = F3 + F3
  F3 = F3 + F2
  F4 = RSQRTS F3                ; refined once (Newton): y (1.5 - 0.5 x y y)
  F6 = F4 * F4
  F6 = F6 * F3
  F7 = 0.5
  F6 = F6 * F7
  F7 = 1.5
  F6 = F7 - F6
  F4 = F4 * F6                  ; F4: the unison gain
; MIX: the wave at min(1, 2 MIX), the sub at min(1, 2 (1 - MIX)), together at a steady level, 1 / sqrt(w^2 + s^2).
  F6 = DM(V_MIX)
  F6 = F6 + F6
  F6 = MIN(F6, F2)              ; F6: the wave's share
  F7 = DM(V_MIX)
  F7 = F2 - F7
  F7 = F7 + F7
  F7 = MIN(F7, F2)              ; F7: the sub's share
  F3 = F6 * F6
  F0 = F7 * F7
  F3 = F3 + F0
  F0 = RSQRTS F3                ; refined once
  F1 = F0 * F0
  F1 = F1 * F3
  F5 = 0.5
  F1 = F1 * F5
  F5 = 1.5
  F1 = F5 - F1
  F0 = F0 * F1                  ; F0: 1 / sqrt(w^2 + s^2)
  F3 = 0.000012207031           ; 0.4 / 32768: SAMPLE's level (emulator: SAMPLE peaked at 0.4 of Morpha's
  F0 = F0 * F3                  ; unscaled read of the same sample, 0.063 against 0.157)
  F4 = F4 * F6
  F4 = F4 * F0
  DM(V_WGAIN) = F4
  F7 = F7 * F0
  DM(V_SGAIN) = F7

; WARP's constants.
  F0 = DM(V_AMT)
  F1 = F2 - F0
  DM(V_1MA) = F1
  F1 = 3.0
  F1 = F0 * F1
  F1 = F1 + F2
  DM(V_SYNC) = F1
  F1 = 4.0
  F1 = F0 * F1
  F1 = F1 + F2
  F3 = 0.000030517578           ; 1 / 32768
  F1 = F1 * F3
  DM(V_FOLDK) = F1

; The block.
  R0 = DM(V_SLOT)
  I0 = R0
  R0 = DM(V_SRC)
  I4 = R0
  R0 = BUILTIN
  I3 = R0
  R10 = 16                      ; read16's constants (R9 is F9, the step)

  R11 = -16
  CALL post_view                ; the screen shows the wave with or without a note
  R0 = DM(V_REC)
  I1 = R0
  R1 = R_PLAYING
  M1 = R1
  R0 = DM(M1, I1)
  R0 = PASS R0
  IF EQ JUMP silence            ; no note: silence
  R15 = 32
sample_loop:
  F8 = DM(M3, I2)
  F9 = DM(V_INC)
  CALL osc
  DM(M3, I2) = F8
  F13 = PASS F12
  R0 = DM(V_UNI)
  R0 = PASS R0
  IF EQ JUMP sub_part
  R1 = 1
  M1 = R1
  F8 = DM(M1, I2)
  F9 = DM(V_INC1)
  CALL osc
  DM(M1, I2) = F8
  F14 = PASS F12
  R1 = 2
  M1 = R1
  F8 = DM(M1, I2)
  F9 = DM(V_INC2)
  CALL osc
  DM(M1, I2) = F8
  F14 = F14 + F12
  F0 = DM(V_G)
  F14 = F14 * F0
  F13 = F13 + F14
sub_part:
  F0 = DM(V_WGAIN)
  F13 = F13 * F0
  F0 = DM(V_SGAIN)
  F1 = 0.0
  COMP(F0, F1)
  IF EQ JUMP out
  R1 = 3
  M1 = R1
  F8 = DM(M1, I2)
  F9 = DM(V_SUBINC)
  CALL subosc
  DM(M1, I2) = F8
  F0 = DM(V_SGAIN)
  F12 = F12 * F0
  F13 = F13 + F12
out:
  DM(I0, M0) = F13
  R15 = R15 - 1
  IF NE JUMP sample_loop
  JUMP done

; The second voice of a track: the first voice's block, from the slot before this one.
copy_pair:
  R0 = DM(V_SLOT)
  I0 = R0
  R1 = -0x80
  R0 = R0 + R1
  I1 = R0
  R15 = 32
copy_loop:
  R0 = DM(I1, M0)
  DM(I0, M0) = R0
  R15 = R15 - 1
  IF NE JUMP copy_loop
  JUMP done

silence:
  R0 = DM(V_SLOT)
  I0 = R0
  R0 = 0
  R15 = 32
silence_loop:
  DM(I0, M0) = R0
  R15 = R15 - 1
  IF NE JUMP silence_loop

done:
  R3 = DM(V_SAVE + 0)
  R5 = DM(V_SAVE + 1)
  R6 = DM(V_SAVE + 2)
  R7 = DM(V_SAVE + 3)
  R9 = DM(V_SAVE + 4)
  R10 = DM(V_SAVE + 5)
  R11 = DM(V_SAVE + 6)
  R15 = DM(V_SAVE + 7)
  I0 = DM(V_SAVE + 8)
  I1 = DM(V_SAVE + 9)
  I2 = DM(V_SAVE + 10)
  I3 = DM(V_SAVE + 11)
  M0 = DM(V_SAVE + 12)
  M1 = DM(V_SAVE + 13)
  M2 = DM(V_SAVE + 14)
  M3 = DM(V_SAVE + 15)
  L0 = DM(V_SAVE + 16)
  L1 = DM(V_SAVE + 17)
  L2 = DM(V_SAVE + 18)
  R13 = DM(V_SAVE + 21)
  R14 = DM(V_SAVE + 22)
  ASTATX = DM(V_SAVE + 19)
  STKYX = DM(V_SAVE + 20)
  CRET

; unit: F0 held in 0-1. Changes F1.
unit:
  F1 = 0.0
  F0 = MAX(F0, F1)
  F1 = 1.0
  F0 = MIN(F0, F1)
  RTS

; glide: F0 = the voice's state word R1 moved a sixteenth of the way towards F0 a block (time constant about 10 ms),
; stored and returned. Needs I2 = the voice's state. Changes F1, F2, M1.
glide:
  M1 = R1
  F1 = DM(M1, I2)
  F0 = F0 - F1
  F2 = 0.0625
  F0 = F0 * F2
  F0 = F0 + F1
  DM(M1, I2) = F0
  RTS

; osc: one oscillator's sample. F8 = its phase (advanced in place), F9 = its step; returns F12, the wave's value in
; 16-bit units. Reads the table through I4 (R10, R11: the sign extension). Changes R0-R6, F7, M4.
osc:
  F8 = F8 + F9
  F0 = 1.0
  COMP(F8, F0)
  IF GE F8 = F8 - F0
  R0 = DM(V_MODE)
  R1 = 1
  COMP(R0, R1)
  IF EQ JUMP warp_sync
  IF LT JUMP warp_bend
  R1 = 2
  COMP(R0, R1)
  IF EQ JUMP warp_mirr
  F1 = PASS F8                  ; FOLD: the phase as it is
  JUMP warp_done
warp_bend:                      ; u = 2x - 1, u (1 - a + a |u|)
  F1 = F8 + F8
  F0 = 1.0
  F1 = F1 - F0
  F2 = ABS F1
  F3 = DM(V_AMT)
  F2 = F2 * F3
  F3 = DM(V_1MA)
  F2 = F2 + F3
  F1 = F1 * F2
  F0 = 0.5
  F1 = F1 * F0
  F1 = F1 + F0
  JUMP warp_done
warp_sync:                      ; the fraction of x (1 + 3a)
  F3 = DM(V_SYNC)
  F1 = F8 * F3
  R0 = FIX F1
  F2 = FLOAT R0
  COMP(F2, F1)
  IF GT R0 = R0 - 1
  F2 = FLOAT R0
  F1 = F1 - F2
  JUMP warp_done
warp_mirr:                      ; towards 2x, then 2 - 2x
  F2 = F8 + F8
  F0 = 2.0
  F3 = F0 - F2
  F0 = 0.5
  COMP(F8, F0)
  IF GE F2 = PASS F3
  F2 = F2 - F8
  F3 = DM(V_AMT)
  F2 = F2 * F3
  F1 = F8 + F2
warp_done:
; Read the wave at F1 (0-1): two neighbouring samples, linearly, in this wave and the next.
  F0 = DM(V_FLENF)
  F1 = F1 * F0
  R0 = FIX F1
  F2 = FLOAT R0
  COMP(F2, F1)
  IF GT R0 = R0 - 1
  F2 = FLOAT R0
  F7 = F1 - F2                  ; F7: between the two samples
  R1 = DM(V_FLEN)
  R2 = 0
  R0 = MAX(R0, R2)
  R2 = R1 - 1
  R0 = MIN(R0, R2)              ; R0: the first sample
  R2 = R0 + 1
  COMP(R2, R1)
  IF GE R2 = R2 - R1            ; R2: the next, round the wave
  R3 = DM(V_OFF0)
  R4 = R2 + R3
  CALL read16
  R6 = PASS R5
  R4 = R0 + R3
  CALL read16
  F5 = FLOAT R5
  F6 = FLOAT R6
  F6 = F6 - F5
  F6 = F6 * F7
  F12 = F5 + F6                 ; this wave
; A scanned sample: over the wave's last 256 samples, crossfade into the samples just before its start, so the end
; runs on into the start without a click.
  R1 = DM(V_SCAN)
  R1 = PASS R1
  IF EQ JUMP scan_done
  R1 = DM(V_FLEN)
  R4 = 256
  COMP(R3, R4)
  IF LT JUMP scan_done          ; a start under 256 has nothing before it to join
  R6 = R1 - R4                  ; the crossfade's first sample
  R6 = R0 - R6
  IF LT JUMP scan_done          ; before it: the wave as it is
  F6 = FLOAT R6
  F6 = F6 + F7
  F4 = 0.00390625               ; 1 / 256
  F6 = F6 * F4                  ; F6: how far into the crossfade, 0-1
  R4 = R0 + R3
  R4 = R4 - R1                  ; the same place a wave earlier
  DM(V_TMP) = R4
  CALL read16
  F4 = FLOAT R5
  R4 = DM(V_TMP)
  R4 = R4 + 1
  CALL read16
  F5 = FLOAT R5
  F5 = F5 - F4
  F5 = F5 * F7
  F4 = F4 + F5
  F4 = F4 - F12
  F4 = F4 * F6
  F12 = F12 + F4
scan_done:
  F4 = DM(V_T)
  F0 = 0.0
  COMP(F4, F0)
  IF EQ JUMP read_done
  R3 = DM(V_OFF1)
  R4 = R2 + R3
  CALL read16
  R6 = PASS R5
  R4 = R0 + R3
  CALL read16
  F5 = FLOAT R5
  F6 = FLOAT R6
  F6 = F6 - F5
  F6 = F6 * F7
  F5 = F5 + F6                  ; the next wave
  F5 = F5 - F12
  F5 = F5 * F4
  F12 = F12 + F5
read_done:
  R0 = DM(V_MODE)
  R1 = 3
  COMP(R0, R1)
  IF NE JUMP osc_done           ; not IF NE RTS: the assembler's conditional RTS hangs the chip when not taken (FOLD)
; FOLD: the level times 1 + 4a, folded back into -1..1 (a triangle of period 4).
  F0 = DM(V_FOLDK)
  F1 = F12 * F0
  F0 = 1.0
  F1 = F1 + F0                  ; u = t + 1
  F0 = 0.25
  F2 = F1 * F0
  R0 = FIX F2
  F3 = FLOAT R0
  COMP(F3, F2)
  IF GT R0 = R0 - 1
  F3 = FLOAT R0
  F0 = 4.0
  F3 = F3 * F0
  F1 = F1 - F3                  ; u mod 4
  F3 = F0 - F1
  F0 = 2.0
  COMP(F1, F0)
  IF GT F1 = PASS F3
  F0 = 1.0
  F1 = F1 - F0
  F0 = 32768.0
  F12 = F1 * F0
osc_done:
  RTS

; subosc: the built-in table's first wave (a sine) through I3. F8 = its phase (advanced in place), F9 = its step;
; returns F12 in 16-bit units. Changes R0-R2, R5, R6, F7, M4.
subosc:
  F8 = F8 + F9
  F0 = 1.0
  COMP(F8, F0)
  IF GE F8 = F8 - F0
  F0 = 256.0
  F1 = F8 * F0
  R0 = FIX F1
  F2 = FLOAT R0
  COMP(F2, F1)
  IF GT R0 = R0 - 1
  F2 = FLOAT R0
  F7 = F1 - F2
  R1 = 255
  R2 = R0 + 1
  R2 = R2 AND R1
  R0 = R0 AND R1
  R4 = PASS R2
  CALL read16b
  R6 = PASS R5
  R4 = PASS R0
  CALL read16b
  F5 = FLOAT R5
  F6 = FLOAT R6
  F6 = F6 - F5
  F6 = F6 * F7
  F12 = F5 + F6
  RTS

; read16: R5 = the table's sample R4 through I4, sign-extended. A word holds two 16-bit samples, the earlier one in
; its low half (the stock player's sample memory, and the built-in table packed the same way). Needs R9 = -1,
; R10 = 16, R11 = -16. Changes R1, R4, R5, M4.
read16:
  R1 = 1
  R5 = R4 AND R1                ; odd?
  R1 = -1
  R4 = LSHIFT R4 BY R1          ; the word
  M4 = R4
  R1 = R5 * R10 (SSI)
  R1 = R10 - R1                 ; 16 for an even sample (the low half), 0 for an odd one
  R5 = DM(M4, I4)
  R5 = LSHIFT R5 BY R1
  R5 = ASHIFT R5 BY R11
  RTS

; read16b: the same through I3 (the built-in table).
read16b:
  R1 = 1
  R5 = R4 AND R1
  R1 = -1
  R4 = LSHIFT R4 BY R1
  M4 = R4
  R1 = R5 * R10 (SSI)
  R1 = R10 - R1
  R5 = DM(M4, I3)
  R5 = LSHIFT R5 BY R1
  R5 = ASHIFT R5 BY R11
  RTS

; negate: the 64-bit step (R2 whole, R3 fraction) negated in place, and R6 = 1. Changes R0, R4, R5.
negate:
  R6 = 1
  R0 = 0
  R4 = R0 - R3
  R5 = R0 - R2
  R3 = PASS R3
  IF EQ JUMP negate_done        ; no borrow from a zero fraction
  R5 = R5 - 1
negate_done:
  R3 = PASS R4
  R2 = PASS R5
  RTS

; post_view: one word of the view, when this voice's track is the view track. Called before the block's samples, with
; I3, I4, R10 and R11 set for read16 and osc. Changes R0-R6, F7, F8, F9, F12, R13, R15, I1, M1, M4.
post_view:
  R0 = DM(VIEW_TRACK)
  R1 = DM(V_TRACK)
  COMP(R0, R1)
  IF NE JUMP view_done
  R0 = VIEW_MAGIC
  DM(VIEW + 0) = R0
  DM(VIEW + 1) = R1
  F0 = DM(V_POS)
  F1 = 65535.0
  F0 = F0 * F1
  R0 = FIX F0
  DM(VIEW + 2) = R0
  F0 = DM(V_AMT)
  F1 = 255.0
  F0 = F0 * F1
  R0 = FIX F0
  R1 = 8
  R0 = LSHIFT R0 BY R1
  R1 = DM(V_MODE)
  R0 = R0 OR R1
  R1 = DM(V_FRAMES)
  R2 = 16
  R1 = LSHIFT R1 BY R2
  R0 = R0 OR R1
  DM(VIEW + 3) = R0
  R0 = DM(V_VSERIAL)
  R0 = R0 + 1
  DM(V_VSERIAL) = R0
  DM(VIEW + 6) = R0
; A whole wave stays posted for 64 blocks (43 ms), so the screen, which reads it about 30 times a second, sees it
; whole; then the next: three times the sounding wave, then one table wave.
  R13 = DM(V_VFILL)
  R0 = 24
  COMP(R13, R0)
  IF LT JUMP view_fill
  R0 = 88
  COMP(R13, R0)
  IF GE JUMP view_next
  R13 = R13 + 1
  DM(V_VFILL) = R13
  JUMP view_done
view_next:
  R13 = 0
  DM(V_VFILL) = R13
  DM(VIEW + 5) = R13
  R0 = DM(V_VCOUNT)             ; three sounding waves, then a table wave: the sounding one moves 20 times a second
  R0 = R0 + 1
  R1 = 3
  R0 = R0 AND R1
  DM(V_VCOUNT) = R0
  R0 = PASS R0
  IF NE JUMP view_sounding
  R0 = DM(V_VNEXT)              ; table wave n of twelve: n (waves - 1) / 11
  R1 = DM(V_FRAMES)
  R1 = R1 - 1
  R2 = R0 * R1 (SSI)
  F2 = FLOAT R2
  F1 = 0.0909090909
  F2 = F2 * F1
  R2 = FIX F2
  DM(VIEW + 7) = R0             ; which of the twelve
  R0 = R0 + 1
  R1 = 12
  COMP(R0, R1)
  IF GE R0 = R0 - R1
  DM(V_VNEXT) = R0
  JUMP view_which
view_sounding:
  R2 = -1
view_which:
  DM(V_VWHICH) = R2
  DM(VIEW + 4) = R2
view_fill:
; Four points into word 8 + fill.
  R0 = R13 + R13
  R0 = R0 + R0
  DM(V_VP) = R0
  R0 = 0
  DM(V_VJ) = R0
  R15 = 0
view_point_loop:
  R0 = DM(V_VP)
  F0 = FLOAT R0
  F1 = 0.0104166667             ; 1 / 96
  F8 = F0 * F1
  CALL view_point
  R1 = DM(V_VJ)
  R2 = 3
  R1 = LSHIFT R1 BY R2
  R0 = LSHIFT R0 BY R1
  R15 = R15 OR R0
  R0 = DM(V_VP)
  R0 = R0 + 1
  DM(V_VP) = R0
  R0 = DM(V_VJ)
  R0 = R0 + 1
  DM(V_VJ) = R0
  R1 = 4
  COMP(R0, R1)
  IF LT JUMP view_point_loop
  R0 = VIEWB + 32
  I1 = R0
  M1 = R13
  DM(M1, I1) = R15
  R13 = R13 + 1
  DM(V_VFILL) = R13
  DM(VIEW + 5) = R13
view_done:
  RTS

; view_point: R0 = the view's wave at phase F8 as a byte (the level / 256, -127 to 127). Changes R0-R6, F7, F9, F12, M4.
view_point:
  R0 = DM(V_VWHICH)
  R0 = PASS R0
  IF GE JUMP view_plain
  F9 = 0.0
  CALL osc                      ; the sounding wave: warped and morphed, the phase left where it is
  JUMP view_scale
view_plain:
  R1 = DM(V_FRAMES)
  R1 = R1 - 1
  R0 = MIN(R0, R1)              ; the table may have changed since the wave was chosen
  R1 = DM(V_FLEN)
  R3 = R0 * R1 (SSI)
  F0 = DM(V_FLENF)
  F2 = F8 * F0
  R0 = FIX F2
  R2 = 0
  R0 = MAX(R0, R2)
  R2 = R1 - 1
  R0 = MIN(R0, R2)
  R4 = R0 + R3
  CALL read16
  F12 = FLOAT R5
view_scale:
  F0 = 0.00390625               ; 1 / 256
  F12 = F12 * F0
  R0 = FIX F12
  R1 = 127
  R0 = MIN(R0, R1)
  R1 = -127
  R0 = MAX(R0, R1)
  R1 = 255
  R0 = R0 AND R1
  RTS

.data VARS                      ; loaded as zeros: the view starts with table wave 0
.space 256

.data VSTATE
.space 1024

